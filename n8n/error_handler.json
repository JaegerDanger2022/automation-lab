{
  "name": "Lab: error handler",
  "nodes": [
    {
      "id": "49e9903c-b9dc-4506-8624-d06741e75bef",
      "name": "On any failure",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "c9cb7964-6259-43dc-a17f-62cec15db5e1",
      "name": "Alert Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':x: ' + $json.workflow.name + ' failed at ' + $json.execution.lastNodeExecuted + ': ' + $json.execution.error.message + '\\n' + $json.execution.url }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "On any failure": {
      "main": [
        [
          {
            "node": "Alert Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}